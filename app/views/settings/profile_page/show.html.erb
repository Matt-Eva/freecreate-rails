
<%= button_to "logout", session_path, method: :delete if authenticated? %>

<%= link_to "Change Password", settings_password_path %>

<h2>Your Creator Profiles </h2>
<%= link_to "Add New Creator Profile", new_creator_path %>

<% @creators.each do |creator| %>
    <p><%=creator.name%></p>
    <%= link_to "view", settings_creator_path(creator.uuid) %>
    <%= link_to "public page", creator_path(creator.uuid) %>
    <%= link_to "edit", edit_creator_path(creator.uuid) %>
<%end%>
