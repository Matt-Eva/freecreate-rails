<% if Current.user.username %>
<h2>Welcome, <%= Current.user.username%>!</h2>
<%= button_to "logout", session_path, method: :delete if authenticated? %>
   
<%else %>
    <h2>Welcome! </h2>
    <p>You haven't set up a username yet</p>
<% end %>

<h3>Update Username:</h3>
<%= form_with url: "/settings/profile_page/username", method: :patch do |form| %>
    <%= form.label :username, "Enter Username" %>
    <%= form.text_field :username, required: true %>
    <%= form.submit "Update Username" %>
<%end%>

<h3>Your Creator Profiles</h3>

<h3>Add Creator Profile:</h1>
<%= form_with url: "/creator", method: :post do |form|%>
    <%= form.label :name, "Enter Creator Name", required: true%>
    <%= form.text_field :name %>
    <%= form.label :description, "Enter Brief Description (optional - character limit 500)" %>
    <%= form.text_area :description, maxlength: 500 %>
    <%= form.submit "Add Creator" %>
<%end%>