<%= form_with model: @writing, url: update_writing_path, method: :patch do |form| %>
    <%= form.label "title" %>
    <%= form.text_field :title  %>
    <%= form.collection_select :creator_uuid, @creators, :uuid, :name, {selected: @writing.creator}, {class: "form-select"} %>
    <%= form.select :writing_type,
        ["Poetry", "Short Story", "Novellete", "Novella", "Novel", "Essay", "Blog", "Memoir"],
        {selected: @writing.writing_type},
        {class: "form-select"}
    %>
    <div data-controller="edit-checkbox">
        <% Writing::GENRES.each do |genre| %>
           <div>
                <%= check_box_tag "writing[genres][]", genre, @writing.genres.include?(genre), data: {edit_checkbox_target: "checkbox", action: "change->edit-checkbox#checkLimit"}%>
                <%= label_tag "writing_genres_#{genre}", genre %>
           </div>
        <% end %>
    </div>
<% end %>