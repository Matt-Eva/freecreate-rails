<div id="publish_writing_button">
    <% if @writing.published %>
        <label>Unpublishing will remove the visibility of this content, but will not remove it's associated data.</label>
        <%= button_to "unpublish", publish_writing_path(@writing.uuid), method: :patch %>
    <% else %>
        <%= button_to "publish", publish_writing_path(@writing.uuid), method: :patch %>
    <% end %>
</div>