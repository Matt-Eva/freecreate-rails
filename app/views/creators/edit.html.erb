<h1>edit creator</h1>
<%= link_to "cancel", settings_creator_path(@creator.uuid)%>
<%= form_with model: @creator do |form| %>
    <%= form.label :name %>
    <%= form.text_field :name %>
    <%= form.label :description %>
    <%= form.text_field :description %>
    <%= form.submit "update creator" %>
    <%= form.label :about %>
    <%= form.rich_textarea :about %>
<% end %>
<% @creator.errors.full_messages.each do |error| %>
    <p><%= error %></p>
<% end %>