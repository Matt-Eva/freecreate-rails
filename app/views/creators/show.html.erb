<div>
    <h2><%= @creator.name %> </h2>
    <p><%= @creator.description %></p>
    <button>donate</button>
    <button>follow</button>
    <button>subscribe</button>
    <%= link_to "about", about_creator_path(@creator.uuid)%>

</div>

<div>
<% @creator.writings.each do |writing| %>
    <p style="border: solid;"> <%= writing.title %> </p>
<% end %>
</div>